DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conglenh_dev?schema=public"
API_PORT=3001
NODE_ENV=development

# Origin cua apps/web - dung de kiem tra CORS va chan CSRF (xem main.ts).
# Cho phep NHIEU origin cung luc, cach nhau dau phay - vd vua dung
# localhost luc phat trien, vua dung dia chi Tailscale khi truy cap tu xa:
# WEB_ORIGIN="http://localhost:3000,https://ten-may.tail1234.ts.net"
WEB_ORIGIN="http://localhost:3000"

# CHI dat khi dung API_INTERNAL_URL khac mac dinh o apps/web/next.config.ts
# (backend chay port/may khac 127.0.0.1:3001) - thuong khong can doi.

# Doi gia tri nay o moi moi truong that. Dung de ky JWT access token.
JWT_ACCESS_SECRET="doi-chuoi-bi-mat-nay-truoc-khi-dung-that"

# Mat khau tai khoan Quan tri he thong mac dinh khi seed lan dau.
# Bat buoc doi ngay lan dang nhap dau (phaiDoiMatKhau=true).
ADMIN_DEFAULT_PASSWORD="DoiMatKhau@123"

# Sao luu/phuc hoi du lieu (/sao-luu).
#
# Neu Postgres chay qua Docker (may host KHONG co san pg_dump/psql de cai
# them) - dat ten container o day, pg_dump/psql se duoc goi qua "docker exec"
# BEN TRONG container thay vi tren host. Xem ten container bang `docker ps`
# (cot NAMES, dong co IMAGE la postgres).
# POSTGRES_DOCKER_CONTAINER=""
#
# Chi dung 2 dong duoi neu KHONG dung Docker (Postgres cai truc tiep tren may)
# VA pg_dump/psql KHONG nam san tren PATH. De trong -> dung thang lenh
# "pg_dump"/"psql". Vd Windows: "C:\Program Files\PostgreSQL\16\bin\pg_dump.exe"
# PG_DUMP_PATH=""
# PSQL_PATH=""
